# Copy this file to .env.local and replace values with your own.
# ---------- Public (safe in browser) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Preferred public API key from Supabase Settings > API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy public anon key also works if the publishable key is empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Contact details: WhatsApp number in international format, digits only (example: 923001234567).
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_STORE_ADDRESS=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_HERO_IMAGE=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------- Server only (NEVER prefix with NEXT_PUBLIC_) ----------
# Only needed when importing starter products with `npm run seed`.
# Modern server-only secret key also works for seeding.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set true only after enabling the Google provider in Supabase.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Verified Supabase Auth user UUIDs allowed to access /admin (comma separated).
ADMIN_USER_IDS=
